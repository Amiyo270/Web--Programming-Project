{
  "redirects": [
    { "source": "/admin/login", "destination": "/admin/#/login", "permanent": false },
    { "source": "/admin/dashboard", "destination": "/admin/#/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/((?!assets|admin).*)", "destination": "/index.html" }
  ]
}
